# Copy to .env (make up / make env does this for you) and change the secrets.

# --- Backend ---
# Postgres (docker-compose). For a quick local run without Docker use:
# DATABASE_URL=sqlite:///./catchmybus.db
DATABASE_URL=postgresql+psycopg2://catchmybus:change-me-db@db:5432/catchmybus
POSTGRES_USER=catchmybus
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=catchmybus

# JWT signing secret: use a long random string (e.g. `python -c "import secrets;print(secrets.token_hex(32))"`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Only this origin may call the API from a browser (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Rate limit for POST /auth/login (attempts per minute per IP)
LOGIN_RATE_LIMIT_PER_MIN=10

# Simulator
SIMULATOR_ENABLED=true
SIM_TICK_SECONDS=2
SIM_HISTORY_EVERY_SECONDS=10
# >1 makes buses move faster than real time (ETAs are scaled to match)
SIM_SPEED_MULTIPLIER=1
SIM_RANDOM_DELAYS=true

# Alerts
DELAY_ALERT_THRESHOLD_MIN=10
ALERT_CHECK_SECONDS=5

# One-click demo sign-in buttons on the login page (set false for any real deployment)
DEMO_LOGIN_ENABLED=true

# Demo accounts created by `make seed`
SEED_ADMIN_EMAIL=admin@catchmybus.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_COMMUTER_EMAIL=arun@mail.com
SEED_COMMUTER_PASSWORD=Arun@123

# --- Frontend ---
VITE_API_URL=http://localhost:8000
